@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Include SweetAlert2 & Bootstrap Icons -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4f7f6;
    }
    .card {
        border-radius: 0.75rem;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s;
    }
    .input-group-text {
        background-color: #fff;
        color: #6c757d;
    }
</style>

<!-- Login Section -->
<div id="loginSection" class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock text-primary" style="font-size: 3rem;"></i>
                    <h3 class="card-title mt-2 fw-bold">Welcome Back</h3>
                    <p class="text-muted">Please login to manage your products.</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" id="loginUsername" class="form-control" placeholder="Enter your username" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input type="password" id="loginPassword" class="form-control" placeholder="Enter your password" />
                    </div>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-primary py-2 fw-semibold" onclick="login()">Login</button>
                </div>
                <div class="text-center">
                    <small class="text-muted">Don't have an account? <a href="#" class="text-decoration-none fw-bold" onclick="showRegister()">Register here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Register Section -->
<div id="registerSection" class="row justify-content-center mt-5 d-none">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus text-success" style="font-size: 3rem;"></i>
                    <h3 class="card-title mt-2 fw-bold">Create Account</h3>
                    <p class="text-muted">Join us to start managing your inventory.</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" id="regUsername" class="form-control" placeholder="Choose a username" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input type="password" id="regPassword" class="form-control" placeholder="Create a password" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input type="password" id="regConfirmPassword" class="form-control" placeholder="Repeat your password" />
                    </div>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-success py-2 fw-semibold" onclick="register()">Register</button>
                </div>
                <div class="text-center">
                    <small class="text-muted">Already have an account? <a href="#" class="text-decoration-none fw-bold" onclick="showLogin()">Login here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main App Section (Hidden by default) -->
<div id="appSection" class="d-none mt-4">
    
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Product Management</h2>
            <p class="text-muted mb-0">Manage your catalog, prices, and inventory</p>
        </div>
        <button class="btn btn-outline-danger shadow-sm fw-semibold" onclick="logout()">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h6 class="card-subtitle mb-3 text-muted fw-semibold"><i class="bi bi-funnel me-1"></i> Filter Products</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchName" class="form-control border-start-0 ps-0" placeholder="Search by product name..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text border-end-0">Min</span>
                        <input type="number" id="minPrice" class="form-control border-start-0 ps-0" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text border-end-0">Max</span>
                        <input type="number" id="maxPrice" class="form-control border-start-0 ps-0" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-primary w-100 shadow-sm fw-semibold" onclick="loadProducts()">Search</button>
                    <button class="btn btn-light border w-100 shadow-sm fw-semibold" onclick="resetSearch()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-table me-2 text-secondary"></i>Product List</h5>
            <!-- Add Product Button Moved Here -->
            <button class="btn btn-success shadow-sm fw-semibold" onclick="showAddModal()">
                <i class="bi bi-plus-lg me-1"></i> Add Product
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 text-muted">ID</th>
                            <th class="text-muted">Product Name</th>
                            <th class="text-muted">Description</th>
                            <th class="text-muted">Price</th>
                            <th class="pe-4 text-center text-muted">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="productTableBody" class="border-top-0">
                        <!-- Rows populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-box me-2"></i>Add Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="productId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Product Name</label>
                    <input type="text" id="productName" class="form-control" placeholder="e.g. Mechanical Keyboard" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea id="productDesc" class="form-control" rows="3" placeholder="Enter product details..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Price</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" id="productPrice" class="form-control" step="0.01" placeholder="0.00" />
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 bg-light">
                <button type="button" class="btn btn-secondary fw-semibold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-semibold" onclick="saveProduct()">Save Product</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const authUrl = '/api/Auth';
        const productUrl = '/api/Product';
        let productModal;

        // Initialize bootstrap modal on page load
        document.addEventListener('DOMContentLoaded', () => {
            productModal = new bootstrap.Modal(document.getElementById('productModal'));
            checkAuthState();
        });

        // Helper to get auth headers
        function getHeaders() {
            const token = localStorage.getItem('jwt_token');
            return {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            };
        }

        // --- AUTHENTICATION UI TOGGLE ---
        function showLogin() {
            document.getElementById('loginSection').classList.remove('d-none');
            document.getElementById('registerSection').classList.add('d-none');
        }

        function showRegister() {
            document.getElementById('loginSection').classList.add('d-none');
            document.getElementById('registerSection').classList.remove('d-none');
        }

        // --- AUTHENTICATION LOGIC ---
        function checkAuthState() {
            const token = localStorage.getItem('jwt_token');
            if (token) {
                document.getElementById('loginSection').classList.add('d-none');
                document.getElementById('registerSection').classList.add('d-none');
                document.getElementById('appSection').classList.remove('d-none');
                loadProducts();
            } else {
                showLogin();
                document.getElementById('appSection').classList.add('d-none');
            }
        }

        async function login() {
            const username = document.getElementById('loginUsername').value;
            const password = document.getElementById('loginPassword').value;

            if (!username || !password) {
                Swal.fire({ icon: 'warning', title: 'Oops...', text: 'Username and password are required.' });
                return;
            }

            const response = await fetch(`${authUrl}/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            if (response.ok) {
                const data = await response.json();
                localStorage.setItem('jwt_token', data.token);
                checkAuthState(); 
            } else {
                Swal.fire({ icon: 'error', title: 'Login Failed', text: 'Invalid username or password.' });
            }
        }

        async function register() {
            const username = document.getElementById('regUsername').value;
            const password = document.getElementById('regPassword').value;
            const confirmPassword = document.getElementById('regConfirmPassword').value;

            if (!username || !password) {
                Swal.fire({ icon: 'warning', title: 'Oops...', text: 'Username and password are required.' });
                return;
            }

            if (password !== confirmPassword) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Passwords do not match!' });
                return;
            }

            const response = await fetch(`${authUrl}/register`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            if (response.ok) {
                Swal.fire({ icon: 'success', title: 'Success', text: 'Registration successful! Please login.' });
                document.getElementById('regUsername').value = '';
                document.getElementById('regPassword').value = '';
                document.getElementById('regConfirmPassword').value = '';
                showLogin();
            } else {
                const errorData = await response.json();
                Swal.fire({ icon: 'error', title: 'Registration Failed', text: (errorData.message || "Username might already exist.") });
            }
        }

        function logout() {
            localStorage.removeItem('jwt_token');
            checkAuthState();
        }

        // --- PRODUCT MANAGEMENT ---
        async function loadProducts() {
            const name = document.getElementById('searchName').value;
            const min = document.getElementById('minPrice').value;
            const max = document.getElementById('maxPrice').value;

            let query = productUrl; 

            if (name || min || max) {
                const params = new URLSearchParams();
                if (name) params.append('name', name);
                if (min) params.append('minPrice', min);
                if (max) params.append('maxPrice', max);
                query = `${productUrl}/search?${params.toString()}`;
            }

            try {
                const response = await fetch(query, { headers: getHeaders() });

                if (response.status === 401) {
                    logout(); 
                    return;
                }

                const products = await response.json();
                const tbody = document.getElementById('productTableBody');
                tbody.innerHTML = '';

                if (Array.isArray(products) && products.length > 0) {
                    products.forEach(p => {
                        // Added badges and modern buttons for rows
                        tbody.innerHTML += `
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">#${p.id}</td>
                                <td class="fw-bold">${p.name}</td>
                                <td class="text-muted">${p.description || '-'}</td>
                                <td class="fw-semibold text-success">Rp ${p.price.toLocaleString()}</td>
                                <td class="pe-4 text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick='editProduct(${JSON.stringify(p).replace(/'/g, "&apos;")})'>
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteProduct(${p.id})">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>`;
                    });
                } else {
                    // Empty state handler
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No products found.
                            </td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error("Failed to fetch products:", error);
            }
        }

        function clearSearchFields() {
            document.getElementById('searchName').value = '';
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
        }

        function resetSearch() {
            clearSearchFields();
            loadProducts();
        }

        function showAddModal() {
            document.getElementById('productId').value = '';
            document.getElementById('productName').value = '';
            document.getElementById('productDesc').value = '';
            document.getElementById('productPrice').value = '';
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-box me-2"></i>Add Product';
            productModal.show();
        }

        function editProduct(product) {
            document.getElementById('productId').value = product.id;
            document.getElementById('productName').value = product.name;
            document.getElementById('productDesc').value = product.description;
            document.getElementById('productPrice').value = product.price;
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Edit Product';
            productModal.show();
        }

        async function saveProduct() {
            const id = document.getElementById('productId').value;
            const priceInput = document.getElementById('productPrice').value;
            const priceVal = parseFloat(priceInput);

            // Basic validation
            if (!document.getElementById('productName').value || isNaN(priceVal) || priceVal <= 0) {
                Swal.fire({ icon: 'warning', title: 'Invalid Input', text: 'Name is required and Price must be greater than 0!' });
                return;
            }

            const product = {
                name: document.getElementById('productName').value,
                description: document.getElementById('productDesc').value,
                price: priceVal
            };

            let url = productUrl;
            let method = 'POST';
            let actionType = 'added';

            if (id) {
                url = `${productUrl}/${id}`;
                method = 'PUT';
                product.id = parseInt(id);
                actionType = 'updated';
            }

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: getHeaders(),
                    body: JSON.stringify(product)
                });

                if (response.ok) {
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'Success!', 
                        text: `Product successfully ${actionType}!`,
                        timer: 1500,
                        showConfirmButton: false 
                    });
                    
                    productModal.hide();
                    
                    if (actionType === 'added') {
                        clearSearchFields();
                    }
                    
                    loadProducts(); 
                } else {
                    Swal.fire({ icon: 'error', title: 'Failed', text: 'Failed to save product! Please check your inputs.' });
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Server is down or unreachable.' });
                console.error(error);
            }
        }

        async function deleteProduct(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const response = await fetch(`${productUrl}/${id}`, {
                        method: 'DELETE',
                        headers: getHeaders()
                    });

                    if (response.ok) {
                        Swal.fire({ 
                            icon: 'success', 
                            title: 'Deleted!', 
                            text: 'Your product has been deleted.',
                            timer: 1500,
                            showConfirmButton: false 
                        });
                        loadProducts();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed', text: 'Failed to delete product.' });
                    }
                }
            });
        }
    </script>
}