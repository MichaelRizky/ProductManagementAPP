<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs/internal-nlog.txt">

	<targets>
		<!-- Store all logs in the logs/All/ folder -->
		<target xsi:type="File" name="allfile"
				fileName="logs/All/nlog-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

		<!-- Store ONLY error logs in the logs/Error/ folder -->
		<target xsi:type="File" name="errorfile"
				fileName="logs/Error/nlog-error-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

		<!-- Console output for local debugging -->
		<target xsi:type="Console" name="lifetimeConsole" layout="${MicrosoftConsoleLayout}" />
	</targets>

	<rules>
		<!-- show port info in console -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="lifetimeConsole" final="true" />

		<!-- Skip non-critical Microsoft and System logs -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<!-- Route all application logs (Info and above) to the allfile target -->
		<logger name="*" minlevel="Info" writeTo="allfile, lifetimeConsole" />

		<!-- Route ONLY Error and Fatal level logs to the errorfile target -->
		<logger name="*" minlevel="Error" writeTo="errorfile" />
	</rules>
</nlog>